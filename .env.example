# ---- public identity -------------------------------------------------------
PUBLIC_HOSTNAME=lmr.example.com
PUBLIC_URL=https://lmr.example.com          # edges enroll here (via Caddy TLS)
WG_ENDPOINT=lmr.example.com:51820           # edges dial this for the tunnel

# ---- secrets (change all of these) -------------------------------------------
POSTGRES_PASSWORD=change-me-db
SECRET_KEY=change-me-long-random
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin

# ---- network ---------------------------------------------------------------
HTTP_HOST=0.0.0.0        # firewall 8080 so only the WireGuard subnet + localhost reach it
HTTP_PORT=8080
WG_ENABLED=true
WG_INTERFACE=wg-lmr
WG_SUBNET=10.77.0.0/16
WG_PORT=51820
VOICE_PORT=50000
ALLOW_UNTUNNELED_EDGES=false

# ---- DVMProject (FNE) ------------------------------------------------------
FNE_REST_PASSWORD=change-me-fne   # FNE REST API (127.0.0.1:9990), used by KeyUp only
FNE_REST_PORT=9990

# ---- transcoding (native backend only): DVSI AMBE-3000 USB vocoders (comma separated) ---------------
DVSI_PORTS=
DVSI_BAUD=460800

# ---- SIP via Asterisk ARI (docker compose --profile sip up -d) ---------------
ARI_ENABLED=false
ARI_URL=http://127.0.0.1:8088
ARI_USER=lmr
ARI_PASSWORD=change-me-ari
RTP_HOST=127.0.0.1
RTP_PORT_MIN=40000
RTP_PORT_MAX=40999

LOG_LEVEL=INFO
