<Project Sdk="Microsoft.NET.Sdk">
  <!-- KeyUp Dispatch Console for Windows (WPF). Built by .github/workflows/console-windows.yml. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>KeyUpConsole</AssemblyName>
    <RootNamespace>KeyUp.Console</RootNamespace>
    <StartupObject>KeyUp.Console.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>1.0.0</Version>
    <Company>KeyUp</Company>
    <Product>KeyUp Dispatch Console</Product>
    <Description>Dispatch console for the KeyUp LMR system</Description>
    <Copyright>Copyright (C) 2026 KeyUp contributors. GPL-2.0.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../KeyUp.Console.Core/KeyUp.Console.Core.csproj" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- the official WireGuardNT DLL (download.wireguard.com), placed here by the build -->
    <None Include="wireguard.dll" Condition="Exists('wireguard.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
